# Interpaws Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/interpaws

# Required for AI features (get free key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: SendGrid for email notifications
# Get your API key at https://sendgrid.com/
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@interpaws.com

# JWT Configuration (for authentication)
SECRET_KEY=your-secret-key-here-change-in-production

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
